# Chave da API da Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=

# Chave da API do Resend (resend.com)
RESEND_API_KEY=

# E-mail remetente — precisa ser de um domínio verificado no Resend,
# ou use onboarding@resend.dev enquanto testa
FROM_EMAIL=onboarding@resend.dev

# URL e chave de serviço do seu projeto Supabase (supabase.com)
# A chave é a "service_role", nunca a "anon" — fica só no servidor, nunca no navegador
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Opcional — se não definir, o próprio domínio do Vercel é usado
# pra montar o link que aparece na tela de cadastro
SITE_URL=

# Opcional — documentos por dia por advogado antes de bloquear (padrão: 60)
DAILY_LIMIT=

# Opcional — documentos grátis no teste antes de exigir pagamento (padrão: 3)
TRIAL_LIMIT=

# Recomendado — protege a rota de limpeza automática do Storage (roda 1x/dia)
# pra que só o próprio Vercel consiga chamar, não qualquer um que ache a URL.
# Gere qualquer texto aleatório longo e cole aqui.
CRON_SECRET=

# Credenciais de PRODUÇÃO do Mercado Pago (developers.mercadopago.com.br)
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
